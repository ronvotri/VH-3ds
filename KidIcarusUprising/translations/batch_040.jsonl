{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00018","source":"Excuse you. But anyway...","vi":"Giữ ý tứ chút chứ. Mà thôi...","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00019","source":"Now it's REALLY on!","vi":"Giờ mới THẬT SỰ bắt đầu đây!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00020","source":"On to death!                   On to victory!","vi":"Đến chỗ chết nào!             Tiến tới chiến thắng!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00021","source":"Let me get a closer look at that shiny\nnew toy of yours.","vi":"Để ta ngắm kỹ món đồ chơi\nmới sáng bóng của nhóc nào.","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00022","source":"Yaaah!","vi":"Yaaaa!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00023","source":"Lord of the Underworld, it's time for\nyou to pay!","vi":"Chúa tể Underworld,\nđến lúc ông trả giá rồi!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00024","source":"Bwahahahahaha!","vi":"Bwahahahahaha!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00025","source":"You can be awfully cute, Pitty.","vi":"Đôi khi nhóc cũng đáng yêu phết đấy, Pitty.","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00026","source":"But that doesn't mean I won't squash\nyou like a gnat!","vi":"Nhưng đừng tưởng thế mà ta không\nnghiền nhóc bẹp dí như muỗi nhé!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00027","source":"Whoa!","vi":"Ối!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00028","source":"Drat, my arm is stuck.","vi":"Chết tiệt, tay ta kẹt rồi.","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00029","source":"Grefff grrrr ah!","vi":"Grừừừ... AAAAA!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00030","source":"All better!","vi":"Xong, ngon lành!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00031","source":"Here you go!","vi":"Nhận lấy này!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00032","source":"Here you go!                  No thank you!","vi":"Nhận lấy này!                 Thôi, xin kiếu!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00033","source":"Great Sacred Treasure, do your thing!","vi":"Great Sacred Treasure,\nthể hiện sức mạnh đi!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00034","source":"Pitty?","vi":"Pitty?","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00035","source":"I have something to show you!","vi":"Ta có thứ này muốn cho nhóc xem!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00036","source":"No no no!","vi":"Không không không!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00037","source":"If you get caught up in that twister,\nit will tear you apart!","vi":"Nếu bị cuốn vào lốc xoáy đó,\nem sẽ bị xé tan xác!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00039","source":"Playing hard to get, are you?","vi":"Nhóc thích làm cao nhỉ?","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00040","source":"Aaaaaugh!","vi":"Ááááá!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00041","source":"Good thing I've been training.","vi":"May mà mình đã luyện tập.","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00042","source":"It's kind of like watching an elephant\nsprint.","vi":"Trông cứ như đang xem\nmột con voi chạy nước rút ấy.","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00043","source":"Ow!","vi":"Ái!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00044","source":"Did I beat him?","vi":"Em hạ được hắn chưa?","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00045","source":"No, I'm fine. But I could've sprained my\nankle, you know!","vi":"Không, ta vẫn ổn. Nhưng nhỡ ta\nbị trẹo mắt cá thì sao hả nhóc!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00046","source":"Good thing...","vi":"May mà...","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00047","source":"I DIDN'T!","vi":"TA CHẲNG BỊ GÌ!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00048","source":"What's the matter, Hades?","vi":"Sao thế, Hades?","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00049","source":"You had enough?","vi":"Ông hết chịu nổi rồi à?","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00050","source":"Oh, no! I'm just getting started!","vi":"Ồ không! Ta mới khởi động thôi!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00051","source":"Let's see if you can keep up!","vi":"Để xem nhóc theo kịp ta không!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00052","source":"You can't run from me!","vi":"Ông đừng hòng chạy thoát!","status":"draft","batch":"040"}
{"id":"romfs/us/stage/a2500.zrc::[LZ11]::stage/bin.arc::bin/msg_00.bin#00053","source":"Engaging pursuit mode!","vi":"Bật chế độ truy đuổi!","status":"draft","batch":"040"}
